# fast_battery S0 flow. ABC script: src/abc_nodretime.script
# (= yosys default for -genlib with dretime REMOVED; see that file for why).
read_verilog /work/projects/mix-sbox-search/battery/candidates/al_and6b/rtl.v
hierarchy -check -top al_and6b
proc; opt; flatten; opt
memory_map; opt
techmap; opt
abc -genlib /work/projects/mix-sbox-search/flow/mini.genlib -script /work/projects/mix-sbox-search/battery/vendor/abc_nodretime.script
opt; clean
stat
write_verilog -noattr /work/out/al_and6b/_synth/mapped_al_and6b.v
